JIRA_URL=https://your-company.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server
JIRA_USER=bot@your-company.com
JIRA_TOKEN=
REC_JQL=project = REC AND labels = rec-agente AND statusCategory != Done
REC_ANALYST=                    # Optional analyst. Override with --analyst.
SUPPORT_STAGE=off                # on = new requests wait for a support person (/orqen:support) before the analyst
REC_SUPPORT=                     # Optional support person. Override with --person.
APPROVERS_ANALYSIS=              # Analysts who can unblock requests alongside code reviewers
APPROVERS_CODE=                  # Jira accounts of the senior reviewers (jira gate, and who can unblock a BLOCKED request)
APPROVERS_CLIENT=
APPROVERS_EXECUTION=             # People who approve and apply operational work
# Set the destination names to match your Jira workflow.
JIRA_TRANSITIONS=DEVELOPMENT=In Progress,CODE_REVIEW=In Review,CLOSED=Done
SIS_PROJECT=SIS
SIS_TYPE=Task
SIS_LINK=Relates
SIS_TYPE_OPERATIONAL=Task
SIS_TRANSITIONS=DEVELOPMENT=In Progress,CODE_REVIEW=In Review,CLOSED=Done
FACTORY_DIR=
# Who decides in CODE_REVIEW: github (review on the integration PR; default) or jira (/approve and /reject comments)
CODE_REVIEW_GATE=github
GITHUB_REVIEWERS=                # GitHub logins whose PR reviews count in CODE_REVIEW (empty = any reviewer)
BASE_BRANCH=main
TEST_COMMAND=npm test
OPENSPEC_CMD=openspec
AGENT_CMD=claude -p --permission-mode acceptEdits
REC_INTERVAL_SEC=120
REC_LOCK_MIN=90
# Destination branch and command used by orqen pr. This is the only PR: TESTING opens none,
# and the senior does the code review (CODE_REVIEW) on it.
DEVEL_BRANCH=desarrollo
DEVEL_PR_COMMAND=gh pr create --base {base} --head {branch} --title "{key}: {title}" --body-file {body}

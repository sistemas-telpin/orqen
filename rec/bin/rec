#!/usr/bin/env sh
# Wrapper de la CLI del proceso REC. Se puede correr desde cualquier carpeta del repo.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -x "$DIR/node_modules/.bin/tsx" ]; then
  echo "Falta instalar dependencias: npm ci --prefix \"$DIR\"" >&2; exit 1
fi
exec "$DIR/node_modules/.bin/tsx" "$DIR/scripts/cli.ts" "$@"

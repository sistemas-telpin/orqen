JIRA_URL=https://tu-empresa.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server
JIRA_USER=bot@tu-empresa.com
JIRA_TOKEN=
REC_JQL=project = REC AND labels = rec-agente AND statusCategory != Done
REC_ANALISTA=                    # opcional: nombre del analista (también --analista). Si no, se usa el nombre del agente
APROBADORES_ANALISIS=            # analistas: además de APROBADORES_CODIGO, pueden destrabar un REC BLOQUEADO (vacío = cualquiera)
APROBADORES_CODIGO=
APROBADORES_CLIENTE=
TRANSICIONES_JIRA=DESARROLLO=En curso,REVISION_CODIGO=En revisión,CERRADO=Listo
# SIS: al cerrar el análisis (con el OK del analista) se crea este issue y se vincula al REC. Aplica a todos los carriles.
SIS_PROYECTO=SIS
SIS_TIPO=Task
SIS_LINK=Relates
SIS_TIPO_OPERATIVO=Task          # tipo del SIS cuando el REC se resuelve sin código (ej. Incident / Support)
APROBADORES_EJECUCION=           # DBA/infra: autorizan y aplican scripts del carril operativo (vacío = cualquiera)
TRANSICIONES_SIS=DESARROLLO=En curso,REVISION_CODIGO=En revisión,CERRADO=Listo
# Registro por REC dentro del repo (se commitea con la rama): factory/<KEY>/
FACTORY_DIR=
RAMA_BASE={{RAMA_BASE}}
# Los comandos de tests y entornos viven en orqen.yaml (sección entornos)
# {cuerpo} = proposal.md del change (liviano/completo) o factory/<KEY>/ronda-N/analisis.md (directo)
COMANDO_PR=gh pr create --base {{RAMA_BASE}} --head {rama} --title "{key}: {titulo}" --body-file {cuerpo}
OPENSPEC_CMD=openspec
# Modo desatendido (orqen ciclo): solo etapas de agente (DESARROLLO, TESTING, ENTREGA, EJECUCION, VERIFICACION).
# El ANALISIS lo conduce siempre un analista con /orqen:analizar. Ejemplos:
#   claude -p {prompt} --permission-mode acceptEdits
#   codex exec --full-auto {prompt}
#   gemini -p {prompt} --yolo
AGENTE_CMD={{AGENTE_CMD}}
REC_INTERVALO_SEG=120
REC_LOCK_MIN=90

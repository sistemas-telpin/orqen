JIRA_URL=https://your-company.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server
JIRA_USER=bot@your-company.com
JIRA_TOKEN=
REC_JQL=project = REC AND labels = rec-agente AND statusCategory != Done
REC_ANALISTA=                    # Optional analyst name. Override with --analyst. Defaults to the agent name.
APROBADORES_ANALISIS=            # Analysts who can unblock a REC alongside APROBADORES_CODIGO. Empty means anyone.
APROBADORES_CODIGO=
APROBADORES_CLIENTE=
# Set the destination names to match your project's Jira workflow.
TRANSICIONES_JIRA=DESARROLLO=In Progress,REVISION_CODIGO=In Review,CERRADO=Done
# The SIS is created and linked when the analyst approves the analysis. This applies to every lane.
SIS_PROYECTO=SIS
SIS_TIPO=Task
SIS_LINK=Relates
SIS_TIPO_OPERATIVO=Task          # Issue type for operational work (e.g. Incident or Support)
APROBADORES_EJECUCION=           # People who authorize and apply operational changes. Empty means anyone.
TRANSICIONES_SIS=DESARROLLO=In Progress,REVISION_CODIGO=In Review,CERRADO=Done
# Request history is committed with the branch under orqen/work/<KEY>/.
FACTORY_DIR=
RAMA_BASE={{RAMA_BASE}}
# Test and environment commands are configured under entornos in orqen/config.yaml.
# {cuerpo} is proposal.md for a spec change or orqen/work/<KEY>/round-N/analysis.md for the direct lane.
COMANDO_PR=gh pr create --base {{RAMA_BASE}} --head {rama} --title "{key}: {titulo}" --body-file {cuerpo}
OPENSPEC_CMD=openspec
# Unattended mode runs agent stages. A human analyst always leads ANALISIS using /orqen:analyze.
# Examples:
#   claude -p {prompt} --permission-mode acceptEdits
#   codex exec --full-auto {prompt}
#   gemini -p {prompt} --yolo
AGENTE_CMD={{AGENTE_CMD}}
REC_INTERVALO_SEG=120
REC_LOCK_MIN=90

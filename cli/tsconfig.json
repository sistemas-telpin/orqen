{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "types": ["node"],
    "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": true,
    "noEmit": true, "outDir": "dist"

{
  "name": "@telpin-sistemas/orqen",
  "version": "0.1.12",
  "description": "orqen multi-agent orchestration on OpenSpec, from customer request to production.",
  "type": "module",
  "bin": {
    "orqen": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-template.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:e2e": "npm run build && node --import tsx --test test/*e2e.test.ts test/cli.test.ts test/swarm-apply.test.ts test/tools-repository.test.ts test/workflow-environment.test.ts",
    "typecheck": "tsc --noEmit",
    "setup": "npm run build && npm link",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@fission-ai/openspec": "^2.0.0"
  },
  "license": "UNLICENSED",
  "author": "Telpin"
}

# Secrets and personal settings (Git ignores this file). Where the tickets live goes in orqen/config.yaml → conectores.
# Check the connection with: orqen connectors

# Jira (external and/or internal ticket). For a second Jira use another prefix and `credenciales: <PREFIX>` in config.yaml.
JIRA_URL=https://your-company.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server
JIRA_USER=bot@your-company.com
JIRA_TOKEN=
# GitHub Issues / Projects. Empty = use the session of the gh CLI (gh auth login). Scopes: repo (+ project).
GITHUB_TOKEN=
# Asana personal access token
ASANA_TOKEN=

ORQEN_ANALYST=                   # Optional analyst. Override with --analyst.
SUPPORT_STAGE=off                # on = new requests are listed for a support person first. /orqen:support works either way
ORQEN_SUPPORT=                   # Optional support person. Override with --person.
# Approvers: accounts of the external ticket tool (Jira account id, GitHub login, Asana user id). Empty = anyone.
APPROVERS_ANALYSIS=              # Analysts who can unblock requests alongside code reviewers
APPROVERS_QA=                    # QA people who can /approve or /reject in QA_REVIEW (full lane only; empty = anyone)
APPROVERS_CODE=                  # Senior reviewers (ticket gate, and who can unblock a BLOCKED request)
APPROVERS_CLIENT=
APPROVERS_EXECUTION=             # People who approve and apply operational work
FACTORY_DIR=
# Who decides in CODE_REVIEW: github (review on the integration PR; default) or ticket (/approve and /reject comments)
CODE_REVIEW_GATE=github
GITHUB_REVIEWERS=                # GitHub logins whose PR reviews count in CODE_REVIEW (empty = any reviewer)
BASE_BRANCH=main
TEST_COMMAND=npm test
OPENSPEC_CMD=openspec
AGENT_CMD=claude -p --permission-mode acceptEdits
ORQEN_INTERVAL_SEC=120
ORQEN_LOCK_MIN=90
# Destination branch and command used by orqen pr. This is the only PR: TESTING opens none,
# and the senior does the code review (CODE_REVIEW) on it.
DEVEL_BRANCH=desarrollo
DEVEL_PR_COMMAND=gh pr create --base {base} --head {branch} --title "{key}: {title}" --body-file {body}

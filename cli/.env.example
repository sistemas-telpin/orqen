JIRA_URL=https://telpin.atlassian.net
JIRA_DEPLOYMENT=cloud            # cloud | server
JIRA_USER=bot@telpin.com.ar
JIRA_TOKEN=
REC_JQL=project = REC AND labels = rec-agente AND statusCategory != Done
REC_ANALYST=                     # opcional: nombre del analista (también --analyst). Si no, se usa el nombre del agente
APPROVERS_ANALYSIS=              # analistas: además de APPROVERS_CODE, pueden destrabar un REC BLOCKED (vacío = cualquiera)
APPROVERS_CODE=
APPROVERS_CLIENT=
JIRA_TRANSITIONS=DEVELOPMENT=En curso,CODE_REVIEW=En revisión,CLOSED=Listo
# SIS: al cerrar el análisis (con el OK del analista) se crea este issue y se vincula al REC. Aplica a todos los carriles.
SIS_PROJECT=SIS
SIS_TYPE=Task
SIS_LINK=Relates
SIS_TYPE_OPERATIONAL=Task        # tipo del SIS cuando el REC se resuelve sin código (ej. Incident / Support)
APPROVERS_EXECUTION=             # DBA/infra: autorizan y aplican scripts del carril operativo (vacío = cualquiera)
SIS_TRANSITIONS=DEVELOPMENT=En curso,CODE_REVIEW=En revisión,CLOSED=Listo
# Registro por REC dentro del repo (se commitea con la rama): orqen/work/<KEY>/
FACTORY_DIR=
BASE_BRANCH=main
TEST_COMMAND=npm test
# {body} = proposal.md del change (light/full) o orqen/work/<KEY>/round-N/analysis.md (direct)
# Variables: {key} {branch} {title} {body} {change} {change_dir}
PR_COMMAND=gh pr create --base main --head {branch} --title "{key}: {title}" --body-file {body}
OPENSPEC_CMD=openspec
# Modo desatendido (orqen cycle): solo etapas de agente (DEVELOPMENT, TESTING, DELIVERY, EXECUTION, VERIFICATION).
# El ANALYSIS lo conduce siempre un analista con /orqen:analyze. Ejemplos:
#   claude -p {prompt} --permission-mode acceptEdits
#   codex exec --full-auto {prompt}
#   gemini -p {prompt} --yolo
AGENT_CMD=claude -p {prompt} --permission-mode acceptEdits
REC_INTERVAL_SEC=120
REC_LOCK_MIN=90
